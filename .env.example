# ==============================================================================
# Ledger AI — Environment Configuration Example
# Copy this file to '.env' for local development.
# For cloud deployment (Render / Hugging Face), set these in the dashboard secrets.
# ==============================================================================

# Groq API Keys (Primary & Secondary Rotation)
GROQ_API_KEY=gsk_your_primary_groq_api_key_here
GROQ_API_KEY1=gsk_your_secondary_groq_api_key_here
GROQ_API_KEY2=gsk_your_tertiary_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Razorpay Integration Credentials (Optional)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# Server Environment
FLASK_ENV=production
